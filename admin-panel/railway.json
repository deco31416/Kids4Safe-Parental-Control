{
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "app/**/*",
      "components/**/*",
      "contexts/**/*",
      "hooks/**/*",
      "lib/**/*",
      "package.json",
      "pnpm-lock.yaml",
      "next.config.js",
      "tailwind.config.ts"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "startCommand": "pnpm start"
  },
  "healthcheck": {
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 40
  }
}
