# Kids4Safe Admin Panel - desarrollo local
# Copiar como .env.local. No incluir secretos en variables NEXT_PUBLIC_*.

# URLs visibles en el navegador
NEXT_PUBLIC_BACKEND_URL=http://localhost:7000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:7000
NEXT_PUBLIC_REALTIME_URL=http://localhost:7000/realtime

# Fallback opcional solo para servidores STUN publicos; TURN se obtiene del backend.
NEXT_PUBLIC_ICE_SERVERS_JSON=

# Variables exclusivas del servidor Next.js
BACKEND_URL=http://localhost:7000
ADMIN_API_KEY=

# Para Railway usar .env.railway.example como referencia, sin copiar secretos aqui.
