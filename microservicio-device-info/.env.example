# Device Context Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=device-context-service
PORT=5001
ENV=development

# Admin API Key (protege endpoints internos)
ADMIN_API_KEY=

# Redis
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
# O separado:
REDIS_HOST="iriguchi.proxy.rlwy.net"
REDIS_PORT="12043"
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
DEVICE_CONTEXT_TTL_SECONDS=300

# Backend URL (para llamadas internas)
BACKEND_URL=http://localhost:7000
ALLOWED_ORIGINS=http://localhost:7000
LOG_LEVEL=INFO
