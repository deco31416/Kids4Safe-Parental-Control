# Session Orchestrator Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=session-orchestrator-service
SERVICE_VERSION=3.1.0
PORT=5005
ENV=development

# Admin API Key
ADMIN_API_KEY=

# Redis (CRÍTICO para este servicio)
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
SESSION_TTL_SECONDS=30
MAX_ACTIVE_SESSIONS=1000
