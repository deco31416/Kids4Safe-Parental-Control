# Location Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=location-service
PORT=5002
ENV=development

# Obligatoria. Debe coincidir con ADMIN_API_KEY del backend.
ADMIN_API_KEY=
BACKEND_URL=http://localhost:7000

REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Retencion temporal de coordenadas sensibles.
LOCATION_CURRENT_TTL_SECONDS=120
LOCATION_HISTORY_TTL_SECONDS=3600
LOCATION_HISTORY_MAX_POINTS=100

LOG_LEVEL=INFO
