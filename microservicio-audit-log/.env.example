# Audit Log Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=audit-log-service
PORT=5006
ENV=development

# Admin API Key
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# MongoDB (CRÍTICO para este servicio)
MONGODB_URI=mongodb://localhost:27017/QR-MONITOR

# Backend URL
BACKEND_URL=http://localhost:7000
LOG_LEVEL=INFO
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
