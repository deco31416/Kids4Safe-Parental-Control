# Policy Engine Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=policy-engine-service
PORT=5007
ENV=development

# Admin API Key
ADMIN_API_KEY=

# Este servicio es stateless (no necesita Redis ni Mongo)
LOG_LEVEL=INFO
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
