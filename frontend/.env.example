# Kids4Safe Frontend - desarrollo local
# Copiar como .env.local. No incluir secretos en variables NEXT_PUBLIC_*.

NEXT_PUBLIC_BACKEND_URL=http://localhost:7000
NEXT_PUBLIC_REALTIME_URL=http://localhost:7000/realtime
NEXT_PUBLIC_MOBILE_APP_URL=http://localhost:8081
NEXT_PUBLIC_SITE_URL=https://kids4safe.io
# false para previews; desarrollo siempre queda fuera de indexacion.
SEO_INDEXABLE=false

# Fallback opcional solo para servidores STUN publicos; TURN se obtiene del backend.
NEXT_PUBLIC_ICE_SERVERS_JSON=

# URL exclusiva de las API routes ejecutadas por Next.js.
BACKEND_URL=http://localhost:7000

# Para Railway usar .env.railway.example como referencia.
