# ========================================
# Location Track Service - copiar como .env.local
# ========================================

SERVICE_NAME=location-track-service
PORT=5008
ENV=development

# Security
ADMIN_API_KEY=

# Orígenes permitidos para peticiones del navegador (lista separada por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8081

# MongoDB (OBLIGATORIO para guardar historial)
MONGODB_URI=mongodb://localhost:27017/QR-MONITOR

# Backend URL (para callbacks si se necesitan)
BACKEND_URL=http://localhost:7000
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
