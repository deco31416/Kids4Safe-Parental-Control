{
  "name": "kids4safe-mobile",
  "version": "1.0.4",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.9",
      "@react-native/metro-config": "0.85.3",
      "form-data@4": "4.0.6",
      "image-size": "file:./vendor/metro-image-metadata",
      "js-yaml@4": "4.3.1",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.26",
      "shell-quote@1": "1.10.0",
      "socket.io-parser@4": "4.2.7",
      "uuid@7": "11.1.1",
      "ws@8": "8.21.3"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "typecheck": "tsc --noEmit",
    "test:regression": "node --test test/*.test.cjs",
    "test:image-metadata": "node --test vendor/metro-image-metadata/index.test.js",
    "verify:push-config": "node scripts/verify-native-push-config.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.0",
    "axios": "1.19.0",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.12",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "^56.0.4",
    "expo-location": "~56.0.18",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-secure-store": "^56.0.0",
    "expo-sensors": "~56.0.6",
    "expo-status-bar": "^56.0.0",
    "expo-task-manager": "~56.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.85.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "124.0.7",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "56.0.8",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
