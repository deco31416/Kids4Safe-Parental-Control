# Kids4Safe App Movil - desarrollo local
# Copiar como .env.local. Toda variable EXPO_PUBLIC_* queda visible en la app.

# Web/iOS simulator: localhost. Android emulator: 10.0.2.2.
# Dispositivo físico: usar la IP LAN del equipo, nunca una credencial en la URL.
EXPO_PUBLIC_API_URL=http://localhost:7000

# Fallback STUN publico sin credenciales; TURN temporal se obtiene del backend.
EXPO_PUBLIC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Opcional para builds y notificaciones administrados por EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id

# Archivos cliente Firebase. En EAS usar variables de tipo File.
# En local apuntar a archivos fuera de Git o ubicarlos en app-movil/firebase/.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=

# Activar en CI/EAS para fallar el build si falta la configuración nativa PUSH.
REQUIRE_NATIVE_PUSH_CONFIG=false
