# IP Classifier Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=ip-classifier-service
PORT=5009
ENV=development

# Obligatoria. Debe coincidir con ADMIN_API_KEY del backend.
ADMIN_API_KEY=
BACKEND_URL=http://localhost:7000

# Encabezado interno calculado por el backend; no usar X-Forwarded-For directo.
TRUSTED_IP_HEADER=x-client-ip

# Proveedores HTTPS.
IPAPI_CO_ENABLED=true
IPGEOLOCATION_API_KEY=

# El endpoint gratuito de ip-api.com usa HTTP. Mantener deshabilitado.
IP_API_ENABLED=false
ALLOW_INSECURE_IP_API=false

OUTBOUND_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
