# Screen Recorder Service - copiar como .env.local
# Nunca guardar credenciales reales en esta plantilla.
SERVICE_NAME=screen-recorder-service
PORT=5003
ENV=development

ADMIN_API_KEY=
BACKEND_URL=http://localhost:7000
EVIDENCE_RECORDER_ENABLED=true
CAPTURE_INTERVAL_SECONDS=15
AUDIO_SEGMENT_SECONDS=10
RECORDER_MAX_IMAGE_BYTES=700000
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
# Fallback si REDIS_URL no está definido.
REDIS_HOST="iriguchi.proxy.rlwy.net"
REDIS_PORT="12043"
STORAGE_PATH=../local-storage/screen-recorder
MAX_FRAME_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
FRAME_RETENTION_SECONDS=86400
LOG_LEVEL=INFO
