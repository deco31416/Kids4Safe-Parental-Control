# Kids4Safe Backend - plantilla para desarrollo local
# Copiar como .env.local. Nunca guardar credenciales reales en este archivo.

# Servidor
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:7000
MEDIA_STORAGE_ROOT=../local-storage/backend
MEDIA_MAX_FILE_BYTES=104857600
LOG_HTTP_REQUESTS=false
PORT=7000
RUN_SEEDS=false
ALLOW_USER_RESET=false
ALLOW_USER_FIX=false
LOG_LEVEL=info
LOG_RUNTIME_INFO=false

# Persistencia
MONGODB_URI=mongodb://localhost:27017/QR-MONITOR
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@iriguchi.proxy.rlwy.net:12043"
REDIS_KEY_PREFIX=Kids4Safe:local:

# Autenticacion. Reemplazar por valores locales unicos antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_PEPPER=replace-with-a-random-local-pepper
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
ADMIN_API_KEY=
# Opcionales: si se omiten en desarrollo, admin y viewer usan ADMIN_PASSWORD.
# SEED_ADMIN_PASSWORD=replace-with-a-second-strong-local-password
# SEED_VIEWER_PASSWORD=replace-with-a-third-strong-local-password
SEED_ADMIN_EMAIL=admin@qr-deco.local
SEED_VIEWER_EMAIL=viewer@qr-deco.local

# Aplicaciones y CORS
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
MOBILE_APP_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:8081

# Sesiones y limites
SESSION_EXPIRY=3600
SESSION_PAUSE_EXPIRY=86400
SESSION_MAX_DURATION=3600
ACTIVE_SESSION_STALE_MS=300000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MOBILE_EMERGENCY_START_RATE_LIMIT=10
QR_BROWSER_RECONNECT_MS=15000
PUBLISHER_DROPPED_RECOVERY_MS=30000

# Microservicios locales
DEVICE_INFO_URL=http://localhost:5001
LOCATION_URL=http://localhost:5002
SCREEN_RECORDER_URL=http://localhost:5003
SESSION_ORCHESTRATOR_URL=http://localhost:5005
AUDIT_LOG_URL=http://localhost:5006
POLICY_ENGINE_URL=http://localhost:5007
LOCATION_TRACK_URL=http://localhost:5008
IP_CLASSIFIER_URL=http://localhost:5009

# Activacion opcional de microservicios
USE_POLICY_ENGINE=false
USE_SESSION_ORCHESTRATOR=false
USE_IP_CLASSIFIER=false
USE_DEVICE_INFO=false
ENABLE_AUDIT_LOGS=true

# Geolocalizacion externa opcional
# IPINFO_API_TOKEN=replace-with-ipinfo-token
# IPGEOLOCATION_IO_API_KEY=replace-with-ipgeolocation-token
# IPGEOLOCATION_API_KEY=replace-with-ipgeolocation-token

# ML triangulation permanece deshabilitado hasta disponer del servicio real
USE_ML_TRIANGULATION=false
ML_TRIANGULATION_URL=
ML_TRIANGULATION_TIMEOUT=2000

# Almacenamiento: filesystem local; Railway inyecta RAILWAY_VOLUME_MOUNT_PATH.
# Las fotos de perfil subidas usan profiles/mobile/ dentro de esa raíz.
# Los avatares iniciales están incluidos en la app; defaultAvatar conserva la elección en MongoDB.

# TURN dinamico: configurar solo en backend; nunca usar secretos NEXT_PUBLIC/EXPO_PUBLIC
# METERED_TURN_APP_NAME=replace-with-metered-app-name
# METERED_TURN_SECRET_KEY=replace-with-metered-secret-key
# METERED_TURN_CREDENTIAL_API_KEY=replace-with-metered-credential-api-key
# Metered TURN service credentials; configure only in the private runtime environment.
METERED_TURN_CREDENTIAL_API_KEY=
METERED_TURN_SECRET_KEY=

METERED_TURN_CREDENTIAL_TTL_SECONDS=7200
# Fallback estatico opcional, solo del lado servidor
# METERED_TURN_USERNAME=replace-with-turn-username
# METERED_TURN_PASSWORD=replace-with-turn-password
METERED_TURN_REGION=South America
METERED_TURN_PLAN_NAME=Free Trial Global
METERED_TURN_QUOTA_GB=0.5
# METERED_TURN_ACTIVATED_AT=YYYY-MM-DD
# METERED_TURN_PERIOD_END=YYYY-MM-DD
WEBRTC_ICE_SERVERS_JSON=

# Web Push opcional
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.local

# Retencion
DATA_RETENTION_DAYS=30

# Caducidad de enlaces multimedia (segundos, entre 60 y 86400)
MEDIA_URL_TTL_SECONDS=3600

