    "body-parser@npm:~1.20.3": "npm:1.20.6",
    "file-type@npm:20.4.1": "npm:21.3.2",
    "qs@npm:~6.14.0": "npm:6.15.2",
    "ajv@npm:8.12.0": "npm:8.18.0",
    "ajv@npm:^8.9.0": "npm:8.18.0",
    "ajv@npm:^6.12.4": "npm:6.14.0",
    "ajv@npm:^6.12.5": "npm:6.14.0",
