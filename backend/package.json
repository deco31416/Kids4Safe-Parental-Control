    "diff@npm:^4.0.1": "npm:4.0.4",
    "webpack@npm:5.97.1": "npm:5.104.1"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.build.tsbuildinfo',{force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\" && nest build",
    "start": "nest start",
    "start:dev": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.build.tsbuildinfo',{force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\" && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "node --test test/request-diagnostics.test.js test/dependency-security.test.js test/seed-security.test.js test/push-request-security.test.js test/pdf-browser-renderer.test.js test/pdf-generator.test.js test/pdf-report-data.test.js test/pdf-report-formatters.test.js test/media-deletion.test.js test/media-response-security.test.js test/audio-recording-storage.test.js test/profile-photo-removal.test.js test/admin-notification-contract.test.js test/admin-session-deletion.test.js test/cors-origins.test.js test/recorder-auth.test.js test/session-security.test.js test/media-link-expiry.test.js test/mobile-default-avatar.test.js",
    "test:avatars": "node --test test/mobile-default-avatar.test.js",
    "test:security": "node --test test/request-diagnostics.test.js test/dependency-security.test.js test/seed-security.test.js test/session-security.test.js test/media-link-expiry.test.js",
    "test:storage": "yarn build && node --test test/storage-filesystem.test.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\" --fix",
    "seed:users": "ts-node src/scripts/seed-users.ts",
    "bootstrap:demo-users": "node scripts/bootstrap-demo-users.mjs",
    "seed:users:prod": "node dist/scripts/seed-users.js",
    "inspect:users": "ts-node src/scripts/inspect-admin-users.ts",
    "verify:passwords": "ts-node src/scripts/verify-passwords.ts"
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "1.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "8.2.2",
    "handlebars": "4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "18.2.1",
    "mongoose": "8.24.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "puppeteer": "25.8.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "socket.io": "^4.6.1",
    "socket.io-adapter": "^2.5.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "11.1.1",
    "web-push": "^3.6.7"
  },
