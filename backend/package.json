{
  "name": "kids4safe-backend",
  "version": "3.1.3",
  "description": "Backend API para Kids4Safe v3 - WebRTC Meet/Zoom-like + Audit + Recordings + QR Policies",
  "author": "Kids4Safe",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "yarn@4.0.2",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "resolutions": {
    "multer@npm:2.0.2": "npm:2.2.0",
